<div class="relative pl-8 md:pl-10">
  <div class="absolute -left-2 top-1.5 w-4 h-4 rounded-full border-2 {{dotClass}} z-10"></div>
  <div class="bg-white dark:bg-primary-800 p-6 rounded-2xl shadow-sm border border-primary-100 dark:border-primary-700">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold {{pillBgClass}} text-primary-800 dark:text-primary-300">{{subtitle}}</span>
        <h3 class="text-xl font-bold text-primary-900 dark:text-white mt-1.5">{{title}}</h3>
      </div>
      <div class="text-right">
        <span class="text-xs font-bold text-primary-500 dark:text-primary-400 {{dateBgClass}} px-3 py-1 rounded-full uppercase tracking-wider">{{date}}</span>
      </div>
    </div>
    {{#if description}}
      <p class="text-sm text-primary-600 dark:text-primary-300">{{{description}}}</p>
    {{/if}}
    {{#if tags}}
      <div class="flex flex-wrap gap-2 mt-4">
        {{#each tags}}
          <span class="px-2 py-1 text-xs rounded-md bg-primary-100 dark:bg-primary-700 text-primary-600 dark:text-primary-300">{{this}}</span>
        {{/each}}
      </div>
    {{/if}}
  </div>
</div>
